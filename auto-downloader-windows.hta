<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>ebird2ornitho Updater</title>
    <hta:application 
        id="updaterApp"
        applicationName="ebird2ornithoUpdater"
        border="thin"
        borderStyle="normal"
        caption="yes"
        icon=""
        maximizeButton="no"
        minimizeButton="yes"
        navigable="no"
        scroll="no"
        selection="no"
        singleInstance="yes"
        showInTaskbar="yes"
    />
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: #f4f6f8;
            color: #1e293b;
            margin: 0;
            padding: 50px;
            user-select: none;
        }
        .card {
            background: #ffffff;
            border-radius: 20px;
            padding: 60px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
            text-align: center;
        }
        h2 {
            margin-top: 0;
            color: #0f172a;
            font-size: 48px;
            margin-bottom: 40px;
        }
        p {
            font-size: 26px;
            color: #475569;
            line-height: 1.6;
            margin-bottom: 50px;
        }
        .status {
            margin: 40px 0;
            padding: 30px;
            font-weight: bold;
            font-size: 32px;
            border-radius: 15px;
            background: #f1f5f9;
            color: #334155;
        }
        .btn-group {
            margin-top: 50px;
            text-align: center;
        }
        button {
            padding: 25px 50px;
            font-size: 24px;
            font-weight: 700;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            margin: 0 20px;
        }
        .btn-primary {
            background-color: #2563eb;
            color: white;
        }
        .btn-primary:hover {
            background-color: #1d4ed8;
        }
        .btn-secondary {
            background-color: #e2e8f0;
            color: #475569;
        }
        .btn-secondary:hover {
            background-color: #cbd5e1;
        }
        .steps {
            text-align: left;
            background: #f8fafc;
            border: 3px solid #e2e8f0;
            padding: 40px;
            border-radius: 15px;
            font-size: 24px;
            color: #334155;
            line-height: 1.8;
            display: none;
            margin-top: 40px;
        }
        .steps strong {
            font-size: 28px;
            display: block;
            margin-bottom: 15px;
        }
    </style>
    <script>
        // Auf 1000x1000 Pixel gesetzt
        var winWidth = 1000;
        var winHeight = 1000;
        
        window.resizeTo(winWidth, winHeight);
        window.moveTo((screen.width - winWidth) / 2, (screen.height - winHeight) / 2);

        function startUpdate() {
            document.getElementById('view-start').style.display = 'none';
            document.getElementById('view-progress').style.display = 'block';

            setTimeout(runPowerShell, 100);
        }

        function runPowerShell() {
            try {
                var shell = new ActiveXObject("WScript.Shell");
                var repoUrl = "https://github.com/FlorianH27/ebird2ornitho/archive/refs/heads/main.zip";
                
                var psScript = "$zip = 'latest.zip'; " +
                               "$temp = 'temp_update'; " +
                               "Invoke-WebRequest -Uri '" + repoUrl + "' -OutFile $zip; " +
                               "Expand-Archive -Path $zip -DestinationPath $temp -Force; " +
                               "Get-ChildItem -Path ($temp + '/*/*') | Copy-Item -Destination '.' -Recurse -Force; " +
                               "Remove-Item -Path $temp -Recurse -Force; " +
                               "Remove-Item -Path $zip -Force;";

                var fullCommand = "powershell -NoProfile -ExecutionPolicy Bypass -Command \"" + psScript + "\"";

                var res = shell.Run(fullCommand, 0, true);

                if (res === 0) {
                    document.getElementById('view-progress').style.display = 'none';
                    document.getElementById('view-success').style.display = 'block';
                    document.querySelector('.steps').style.display = 'block';
                } else {
                    throw new Error("Fehlercode " + res);
                }
            } catch(e) {
                var statusText = document.getElementById('status-text');
                statusText.innerText = "Fehler beim Update! Bitte Internetverbindung prüfen.";
                statusText.style.background = "#fee2e2";
                statusText.style.color = "#991b1b";
                statusText.style.fontSize = "26px";
            }
        }
    </script>
</head>
<body>

<div class="card">
    <h2>ebird2ornitho Auto-Updater</h2>
    
    <div id="view-start">
        <p>Möchtest du die neuesten Dateien von GitHub herunterladen und diesen Ordner überschreiben?</p>
        <div class="btn-group">
            <button class="btn-primary" onclick="startUpdate()">Jetzt Aktualisieren</button>
            <button class="btn-secondary" onclick="window.close()">Abbrechen</button>
        </div>
    </div>

    <div id="view-progress" style="display: none;">
        <div class="status" id="status-text">Lade neueste Dateien von GitHub herunter...</div>
    </div>

    <div id="view-success" style="display: none;">
        <div class="status" style="background: #dcfce7; color: #166534;">Update erfolgreich!</div>
        <div class="steps">
            <strong>Nächster Schritt im Browser:</strong>
            1. Browser öffnen<br>
            2. <i>Erweiterungen verwalten</i> aufrufen<br>
            3. Bei <b>ebird2ornitho</b> auf <b>"Erneut laden"</b> klicken
        </div>
        <div class="btn-group">
            <button class="btn-primary" onclick="window.close()">Schließen</button>
        </div>
    </div>
</div>

</body>
</html>